{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-vs2022",
      "displayName": "Windows x64 / VS 2022 / vcpkg",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_CONFIGURATION_TYPES": "Release;RelWithDebInfo",
        "USRP_UHD_ROOT": "$env{UHD_ROOT}",
        "BUILD_TESTING": true
      }
    },
    {
      "name": "offline",
      "displayName": "Hardware-independent tools and tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/offline",
      "cacheVariables": { "USRP_BUILD_APP": false, "BUILD_TESTING": true, "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "windows-release", "configurePreset": "windows-vs2022", "configuration": "Release" },
    { "name": "windows-relwithdebinfo", "configurePreset": "windows-vs2022", "configuration": "RelWithDebInfo" },
    { "name": "offline", "configurePreset": "offline" }
  ],
  "testPresets": [
    { "name": "windows-release", "configurePreset": "windows-vs2022", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "offline", "configurePreset": "offline", "output": { "outputOnFailure": true } }
  ]
}
