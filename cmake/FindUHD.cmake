# UHD is supplied by an installed SDK (not duplicated by vcpkg).
set(USRP_UHD_ROOT "" CACHE PATH "Root of an installed x64 UHD SDK (include, lib, bin)")
set(_uhd_roots "${USRP_UHD_ROOT}" "$ENV{UHD_ROOT}" "$ENV{UHD_DIR}")
if(WIN32)
    list(APPEND _uhd_roots "$ENV{ProgramFiles}/UHD")
endif()
find_path(UHD_INCLUDE_DIR NAMES uhd/config.hpp HINTS ${_uhd_roots} PATH_SUFFIXES include)
find_library(UHD_LIBRARY NAMES uhd libuhd HINTS ${_uhd_roots} PATH_SUFFIXES lib lib64)
if(WIN32)
    find_file(UHD_RUNTIME_DLL NAMES uhd.dll libuhd.dll HINTS ${_uhd_roots} PATH_SUFFIXES bin lib)
endif()
include(FindPackageHandleStandardArgs)
if(WIN32)
    find_package_handle_standard_args(UHD REQUIRED_VARS UHD_INCLUDE_DIR UHD_LIBRARY UHD_RUNTIME_DLL
        REASON_FAILURE_MESSAGE "Install the Windows x64 UHD SDK and set USRP_UHD_ROOT to its installation root.")
else()
    find_package_handle_standard_args(UHD REQUIRED_VARS UHD_INCLUDE_DIR UHD_LIBRARY)
endif()
if(UHD_FOUND AND NOT TARGET UHD::uhd)
    if(WIN32)
        add_library(UHD::uhd SHARED IMPORTED)
        set_target_properties(UHD::uhd PROPERTIES IMPORTED_IMPLIB "${UHD_LIBRARY}" IMPORTED_LOCATION "${UHD_RUNTIME_DLL}")
    else()
        add_library(UHD::uhd UNKNOWN IMPORTED)
        set_target_properties(UHD::uhd PROPERTIES IMPORTED_LOCATION "${UHD_LIBRARY}")
    endif()
    set_target_properties(UHD::uhd PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${UHD_INCLUDE_DIR}")
endif()
mark_as_advanced(UHD_INCLUDE_DIR UHD_LIBRARY UHD_RUNTIME_DLL)
